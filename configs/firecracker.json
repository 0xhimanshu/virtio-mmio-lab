{
  "boot-source": {
    "kernel_image_path": "@KERNEL@",
    "initrd_path": "@INITRD@",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off nomodule quiet @EXTRA@"
  },
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 1024,
    "smt": false
  },
  "drives": [],
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "06:00:ac:10:00:02",
      "host_dev_name": "tap0"
    }
  ],
  "vsock": {
    "guest_cid": 3,
    "uds_path": "/tmp/lab.vsock"
  }
}
